# 復元検査を通ったコピーだけをホスト側で暗号化する。
[Unit]
Description=OimoBBS authenticated encrypted backups
[Service]
Type=oneshot
WorkingDirectory=/home/patatan/OimoBBS
# ホストのbin/oimosealと、pack対応の同じ保存形式のイメージを用意する。
ExecStart=/home/patatan/OimoBBS/bin/oimoseal sync --container oimobbs-validation-bbs-1 --image oimobbs-validation:local --source var/security/online-backup --output var/security/encrypted-backups
UMask=0077
Nice=15
NoNewPrivileges=true
TimeoutStartSec=10min
