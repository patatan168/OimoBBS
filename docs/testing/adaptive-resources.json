  "automatic_policy": {
    "go_memory_goal": "min(physical RAM, visible cgroup limits) * 75%; explicit GOMEMLIMIT preserved",
    "cache": "guard budget / 8; explicit startup cache_bytes caps at cache_bytes / 4; manual saved ceiling and available headroom also apply",
    "representation_workers": "min(GOMAXPROCS, guard budget / 8 / 8MiB); headroom and manual ceiling also apply; pressure can pause new work",
    "search_workers": "min(GOMAXPROCS, max(1, guard budget / 8 / 32MiB)); slots initialized on first search",
    "reservations": "read 1MiB; POST input 4MiB; prepared posting 4MiB + 16*(frame bytes + capture bytes), unknown-size fallback 16MiB; representation 8MiB; search through response 32MiB",
    "progress": "new public input leaves 8MiB for progress, or 16MiB for POST/pending posting; margin max(16MiB, guard budget / 16)",
    "posting_batch": "on RAM exhaustion commit prepared prefix, release reservations and continue only uncommitted operations FIFO; acknowledge committed prefix before later split groups finish",
    "pressure_gc": "no reserved work, headroom below margin + 32MiB, and heap allocation growth since last GC >= margin; collect once and reobserve",
    "storage": "min(thread count, max(16, 2*GOMAXPROCS)) independent WAL syncs; batch bounds remain 64 operations and 8MiB"
  },
